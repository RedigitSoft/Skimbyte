# Copy the relevant lines into your local.properties (gitignored) — never commit real values here.

# Android SDK path (auto-written by Android Studio; usually no need to set this yourself).
#sdk.dir=/path/to/Android/sdk

# Backend endpoint configuration — fetched into BackendConfig.kt (generated, :shared) and into
# the Android manifest's OAuth-callback intent-filter (androidApp's manifestPlaceholders).
authBaseUrl=https://com.example.app
googleAuthRedirectUri=app://callback
# Leave blank to run the app against the built-in demo/mock data instead of a real backend.
skimbyteApiBaseUrl=

# Base URL prepended to relative image paths the posts API returns (e.g.
# /assets/placeholder-kotlin.png). Defaults to skimbyteApiBaseUrl when unset — only
# set this if the placeholder assets move off the API host (e.g. to a CDN/bucket).
#skimbyteAssetBaseUrl=

# Auth-server product id for this app — provisioned once via POST /admin/products.
# Sent on every register/login call so the auth server knows which app the auth event is for.
skimbyteProductId=

# Apple Development team id for signing iOS device builds (Xcode → Signing & Capabilities, or
# developer.apple.com → Membership). Written into the gitignored iosApp/Configuration/Local.xcconfig
# by :shared:generateIosLocalXcconfig (runs on IDE sync and on every Xcode build; a change is
# picked up on the next build). Leave unset for simulator-only work.
#iosTeamId=

# DigitalOcean Spaces CDN domain for avatar/banner images — the bucket's CDN endpoint
# (copy the real value from the deployment notes; kept out of the repo like the other
# endpoints above). Leave unset to disable remote avatar/banner images.
spacesCdnBaseUrl=
