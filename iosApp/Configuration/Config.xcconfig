TEAM_ID=

PRODUCT_NAME=Skimbyte
PRODUCT_BUNDLE_IDENTIFIER=io.redigit.skimbyte.Skimbyte

// App version — single source of truth in the repo-root VERSION file (shared with the
// Android and desktop Gradle builds), which defines versionName and versionCode.
#include "../../VERSION"
CURRENT_PROJECT_VERSION=$(versionCode)
MARKETING_VERSION=$(versionName)

// Machine-local overrides (signing team, etc.) — generated by :shared:generateIosLocalXcconfig
// from local.properties (iosTeamId=…) and gitignored. Last include wins, so values there
// override the committed defaults above.
#include? "Local.xcconfig"