<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- OAuth deep link: the auth server redirects to skimbyte://auth/callback with tokens
	     (must match local.properties' googleAuthRedirectUri and the auth server's allowlist);
	     iOSApp.swift forwards it to the shared GoogleAuthCallback bridge via onOpenURL. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.redigit.skimbyte.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>skimbyte</string>
			</array>
		</dict>
	</array>
</dict>
</plist>